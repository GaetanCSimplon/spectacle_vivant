DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://spectacle:spectacle@localhost:5432/spectacle
# Production only (config.settings.prod): private S3 bucket
# S3_BUCKET_NAME=
# S3_ENDPOINT_URL=
# S3_REGION_NAME=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# DJANGO_CSRF_TRUSTED_ORIGINS=https://mon-domaine.fr
# E-mails (SMTP relay, e.g. Brevo) and site domain
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
